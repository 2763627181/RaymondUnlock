# URL pública del sitio (sin slash final)
NEXT_PUBLIC_SITE_URL=https://raymondunlock.com

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponer en el cliente. No debe aparecer en ningun archivo "use client".
SUPABASE_SERVICE_ROLE_KEY=
# Solo para aplicar migraciones desde tu maquina; la app no la lee. Usa el
# connection string del "Session pooler" (la conexion directa es solo IPv6).
SUPABASE_DB_URL=

# Resend (correos de cotizacion/reparacion). OPCIONAL: sin RESEND_API_KEY el correo queda
# apagado y el sitio ofrece solo WhatsApp (los tres valores de abajo se ignoran).
RESEND_API_KEY=
# Remitente. Con "onboarding@resend.dev" Resend solo entrega al correo dueño de la cuenta;
# para escribirle a clientes hay que verificar un dominio y usar un remitente de ese dominio.
RESEND_FROM_EMAIL=Raymond Unlock <onboarding@resend.dev>
ORDER_NOTIFICATION_EMAIL=Raymondunlock01@gmail.com
